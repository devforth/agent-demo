    "migrate:local": "pnpm _env:dev npx --yes prisma migrate deploy",
    "migrate:prod": "pnpm _env:prod npx --yes prisma migrate deploy",
    "_env:dev": "dotenvx run -f .env -f .env.local --",
    "_env:prod": "dotenvx run -f .env.prod --"
  },
